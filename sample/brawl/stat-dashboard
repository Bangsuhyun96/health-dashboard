<!DOCTYPE html>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>stat-dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#f5f5f7;
  --bg2:#ffffff;
  --bg3:#ffffff;
  --border:#e0e0e6;
  --text:#1a1a2e;
  --sub:#6b7280;
  --muted:#9ca3af;
  --accent:#f5c518;
  --accent2:#a07800;
  --win:#16a34a;
  --lose:#dc2626;
  --pick:#1d6fb8;
  --ban:#c0392b;
  --r:12px;
  --r2:8px;
}
body{font-family:-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;font-size:14px;background:var(--bg);color:var(--text);min-height:100vh; max-width: 656px; margin: 0 auto;}
a{color:inherit;text-decoration:none;}

/* ── 헤더 ── */
.header{background:var(--bg3);border-bottom:1px solid var(--border);padding:16px 20px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100;}
.header-badge{background:var(--accent);color:#000;font-size:10px;font-weight:700;padding:3px 8px;border-radius:4px;letter-spacing:.5px;}
.header-title{font-size:17px;font-weight:700;color:var(--text);}
.header-sub{font-size:11px;color:var(--sub);margin-left:auto;}

/* ── 탭 네비 ── */
.nav{display:flex;gap:4px;padding:12px 16px;background:var(--bg3);border:1px solid var(--border);overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--r);}
.nav::-webkit-scrollbar{display:none;}
.nav-btn{font-family:inherit;font-size:12px;font-weight:600;padding:7px 14px;border:1.5px solid var(--border);border-radius:20px;background:transparent;color:var(--sub);cursor:pointer;white-space:nowrap;transition:all .2s;}
.nav-btn.on{background:var(--accent);color:#000;border-color:var(--accent);}
.nav-btn:hover:not(.on){border-color:var(--accent);color:var(--accent);}

/* ── 섹션 ── */
.section{display:none;padding:8px 16px 16px 16px;}
.section.on{display:block;}

/* ── 카드 ── */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:12px;}
.card-title{font-size:13px;font-weight:700;color:var(--sub);letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border);}

/* ── 요약 카드 그리드 ── */
.summary-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px;}
.summary-grid.four{grid-template-columns:repeat(4,1fr);}
@media(max-width:500px){.summary-grid.four{grid-template-columns:repeat(2,1fr);}}
.stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:14px 12px;text-align:center;}
.stat-val{font-size:22px;font-weight:700;color:var(--accent);margin-bottom:2px;}
.stat-label{font-size:11px;color:var(--sub);}
.stat-sub{font-size:10px;color:var(--muted);margin-top:2px;}

/* ── 테이블 ── */
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{width:100%;border-collapse:collapse;font-size:12px;}
th{padding:8px 10px;text-align:left;color:var(--sub);font-weight:600;font-size:11px;border-bottom:1px solid var(--border);white-space:nowrap;}
td{padding:8px 10px;border-bottom:1px solid var(--border);vertical-align:middle;white-space:nowrap;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:rgba(0,0,0,.02);}
.tc{text-align:center;}

/* ── 배지 ── */
.badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;}
.badge-win{background:rgba(22,163,74,.12);color:var(--win);}
.badge-lose{background:rgba(220,38,38,.12);color:var(--lose);}
.badge-gold{background:rgba(201,160,0,.12);color:var(--accent);}
.badge-pick{background:rgba(29,111,184,.12);color:var(--pick);}
.badge-ban{background:rgba(192,57,43,.12);color:var(--ban);}
.badge-global{background:rgba(220,38,38,.15);color:var(--lose);}
.badge-mvp{background:rgba(201,160,0,.15);color:var(--accent);}

/* ── 차트 래퍼 ── */
.chart-wrap{position:relative;width:100%;}

/* ── 매치 카드 ── */
.match-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);margin-bottom:10px;overflow:hidden;}
.match-header{display:flex;align-items:center;padding:10px 14px;border-bottom:1px solid var(--border);gap:8px;}
.match-round{font-size:10px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.5px;}
.match-time{font-size:10px;color:var(--muted);margin-left:auto;}
.match-score-row{display:flex;align-items:center;padding:12px 14px;gap:10px;}
.team-name{flex:1;font-size:13px;font-weight:700;}
.team-name.win{color:var(--win);}
.team-name.right{text-align:right;}
.match-score{font-size:20px;font-weight:700;text-align:center;min-width:60px;}
.game-rows{padding:0 14px 10px;}
.game-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid rgba(0,0,0,.06);font-size:11px;}
.game-row:last-child{border-bottom:none;}
.game-num{color:var(--muted);width:18px;flex-shrink:0;}
.game-mode{color:var(--sub);flex:1;font-size:10px;}
.game-map{color:var(--text);flex:2;}
.game-picks{display:flex;gap:4px;flex:3;}
.pick-box{display:flex;gap:3px;align-items:center;}
.pick-tag{font-size:10px;padding:1px 6px;border-radius:3px;font-weight:600;}
.pick-tag.blue{background:rgba(55,138,221,.2);color:#1d6fb8;}
.pick-tag.red{background:rgba(226,75,74,.2);color:#dc2626;}
.game-result{text-align:right;flex-shrink:0;width:30px;}
.ban-row{padding:6px 14px;background:rgba(192,57,43,.04);border-top:1px solid var(--border);font-size:11px;color:var(--sub);}
.ban-tag{display:inline-block;font-size:10px;background:rgba(192,57,43,.12);color:var(--ban);padding:1px 6px;border-radius:3px;margin:2px 2px 0 0;}
.global-ban-tag{display:inline-block;font-size:10px;background:rgba(220,38,38,.12);color:var(--lose);padding:1px 6px;border-radius:3px;margin:2px 2px 0 0;font-weight:700;}
.mvp-row{padding:6px 14px;font-size:11px;color:var(--accent);border-top:1px solid var(--border);}

/* ── 바 차트 (CSS only) ── */
.bar-list{display:flex;flex-direction:column;gap:7px;}
.bar-item{display:flex;align-items:center;gap:8px;}
.bar-name{font-size:11px;color:var(--text);width:80px;flex-shrink:0;text-align:right;}
.bar-track{flex:1;background:rgba(0,0,0,.06);border-radius:3px;height:18px;overflow:hidden;}
.bar-fill{height:100%;border-radius:3px;display:flex;align-items:center;padding-left:6px;font-size:10px;font-weight:700;transition:width .5s ease;}
.bar-fill.pick{background:rgba(29,111,184,.7);}
.bar-fill.ban{background:rgba(192,57,43,.7);}
.bar-count{font-size:11px;color:var(--sub);width:20px;flex-shrink:0;}

/* ── 팀 색상 ── */
.team-hmble{color:#c9a000;}
.team-fut{color:#b91c1c;}
.team-tribe{color:#16a34a;}
.team-zeta{color:#1d6fb8;}
.team-cr{color:#6d28d9;}
.team-realm{color:#92400e;}
.team-rev{color:#b45309;}
.team-bh{color:#0f766e;}

/* ── 픽률/승률 비교 ── */
.brawler-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;}
.brawler-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:10px;}
.brawler-name{font-size:12px;font-weight:700;margin-bottom:6px;}
.brawler-stat{font-size:10px;color:var(--sub);display:flex;justify-content:space-between;margin-bottom:2px;}
.brawler-stat span:last-child{color:var(--text);}
.mini-bar{height:4px;background:rgba(0,0,0,.07);border-radius:2px;margin-top:4px;}
.mini-bar-fill{height:100%;border-radius:2px;}

/* ── 스크롤바 ── */
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:#f0f0f2;}
::-webkit-scrollbar-thumb{background:#c0c0c8;border-radius:2px;}
</style>

<script>
function tab(id,btn){
  document.querySelectorAll('.section').forEach(function(s){s.classList.remove('on');});
  document.querySelectorAll('.nav-btn').forEach(function(b){b.classList.remove('on');});
  var el=document.getElementById('s-'+id);
  if(el)el.classList.add('on');
  btn.classList.add('on');
  if(id==='picks')renderPickBars();
  if(id==='bans')renderBanBars();
  if(id==='maps')renderModeBars();
}
var PICKS={체스터:7,'재용':5,레온:5,오티스:5,찰리:4,미플:4,니타:3,시리우스:3,엠즈:3,셰이드:3,거스:3,나지아:3,미나:3,피어스:3,스튜:3,안젤로:2,나니:2,키트:2,샌디:2,루미:2,에드거:2,진:2,'R-T':2};
var BANS={콜레트:9,모티스:5,크로우:6,레온:3,루미:3,나지아:1,알리:4,미플:4,진:4,키트:2,러프스:2,미나:1,셰이드:2,샌디:1,스튜:2,모:2,올리:2,바이런:2,벨:1,그리프:1,니타:1,엠즈:1,핑크스:1,피어스:2};
var MODES={'Brawl Ball':7,'보unty':5,'Knockout':5,'Gem Grab':4,'Hot Zone':3,'Heist':1};
function makeBar(name,val,max,cls,container){
  var pct=Math.round(val/max*100);
  var d=document.createElement('div');d.className='bar-item';
  d.innerHTML='<div class="bar-name">'+name+'</div><div class="bar-track"><div class="bar-fill '+cls+'" style="width:'+pct+'%">'+val+'</div></div><div class="bar-count">'+val+'</div>';
  container.appendChild(d);
}
function renderPickBars(){
  var el=document.getElementById('pick-bars');if(!el||el.children.length>0)return;
  var sorted=Object.entries(PICKS).sort(function(a,b){return b[1]-a[1];}).slice(0,18);
  var max=sorted[0][1];
  sorted.forEach(function(pair){makeBar(pair[0],pair[1],max,'pick',el);});
}
function renderBanBars(){
  var el=document.getElementById('ban-bars');if(!el||el.children.length>0)return;
  var sorted=Object.entries(BANS).sort(function(a,b){return b[1]-a[1];}).slice(0,16);
  var max=sorted[0][1];
  sorted.forEach(function(pair){makeBar(pair[0],pair[1],max,'ban',el);});
}
function renderModeBars(){
  var el=document.getElementById('mode-bars');if(!el||el.children.length>0)return;
  var sorted=Object.entries(MODES).sort(function(a,b){return b[1]-a[1];});
  var max=sorted[0][1];
  sorted.forEach(function(pair){makeBar(pair[0],pair[1],max,'pick',el);});
}
</script>
